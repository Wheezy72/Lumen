# Lumen Vulnerability Scanner - Backend Environment Variables

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/lumen_scanner

# Redis connection
REDIS_URL=redis://127.0.0.1:6379

# JWT secret and session config
JWT_SECRET=replace_with_strong_random_secret

# Access token lifetime (cookie + JWT)
ACCESS_TOKEN_TTL=15m

# Cookie flags
COOKIE_SECURE=false
# Leave empty for host-only cookies (recommended). Set for production domains if needed.
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=session
REFRESH_COOKIE_NAME=refresh
CSRF_COOKIE_NAME=csrf

# TOTP encryption key (32 bytes, base64). Required for encrypting 2FA secrets at rest.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Lumen Scanner

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Security headers
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self'
CSP_STYLE_SRC='self'
CSP_IMG_SRC='self data:'

# Logging
LOG_LEVEL=info

# Black Lotus Labs Threat Intelligence (conceptual integration)
BLACKLOTUS_API_URL=https://api.blacklotuslabs.com/v1/threats
BLACKLOTUS_API_KEY=

# EPSS API (FIRST)
EPSS_API_URL=https://api.first.org/data/v1/epss
EPSS_TIMEOUT_MS=8000

# Password policy
# Check passwords against HaveIBeenPwned (k-anonymity range API). Disable only for offline deployments.
PWNED_PASSWORDS_CHECK=true

# Scan policy
# When false, targets resolving to private/local IP ranges are rejected by the backend.
ALLOW_PRIVATE_TARGETS=false
# Optional: path to a newline-separated list of common passwords (top 10k)
# COMMON_PASSWORDS_FILE=/path/to/10k-most-common.txt

# Email notifications for scan results (optional)
EMAIL_ENABLED=false
EMAIL_FROM=alerts@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Scheduled scans (optional)
# When enabled, the scheduler script can periodically create scans for the
# targets listed in SCHEDULED_TARGETS. These scans are compared with the
# previous run and a diff-style email is sent.
SCHEDULED_ENABLED=false
SCHEDULED_INTERVAL_MINUTES=60
SCHEDULED_TARGETS=
SCHEDULED_USER_ID=

# Reports output directory
REPORTS_DIR=reports

# Server
PORT=4000
NODE_ENV=development