# Lumen - Backend (.env)

# --- Required (core app) ---
MONGODB_URI=mongodb://localhost:27017/lumen_scanner
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace_with_strong_random_secret

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins.
# For local testing across devices you can use: CORS_ORIGINS=*
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Auth cookie settings (optional) ---
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# Leave COOKIE_DOMAIN empty for local IP testing.
# Set it only when hosting on a real domain (e.g. example.com).
COOKIE_DOMAIN=

# --- Email alerts (optional) ---
# Gmail requires a Google "App Password" (not your normal password).
EMAIL_ENABLED=false
EMAIL_FROM=yourgmail@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_app_password

# --- Public API (optional, /api/publicApi) ---
PUBLIC_API_KEY=replace_with_strong_random_key
# Stable internal identity label for the configured PUBLIC_API_KEY
PUBLIC_API_KEY_ID=default-public-key
# Optional (default: 240 requests / 15 minutes / IP)
PUBLIC_API_RATE_LIMIT_MAX=240

# Optional (default: 120 requests / 15 minutes / IP)
AUTH_RATE_LIMIT_MAX=120

# --- Scanning safety (optional) ---
# By default, localhost/private network targets are blocked to reduce SSRF risk.
ALLOW_PRIVATE_TARGETS=false
# By default, webhook callbacks to localhost/private networks are blocked as well.
ALLOW_PRIVATE_WEBHOOKS=false
# Optional host policy controls (comma-separated hostnames or parent domains)
# SCAN_TARGET_ALLOWLIST=example.com,example.org
# SCAN_BLOCKED_HOSTS=metadata.google.internal
# WEBHOOK_TARGET_ALLOWLIST=hooks.example.com
# WEBHOOK_BLOCKED_HOSTS=localhost

# --- Audit logging ---
# Optional HMAC key for tamper-evident audit chain entries
# AUDIT_LOG_SECRET=replace_with_strong_random_secret
# Optional custom path
# AUDIT_LOG_FILE=logs/audit.log

# --- Reports ---
REPORTS_DIR=reports
